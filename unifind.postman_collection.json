  "item": [
    {
      "name": "01. [H1] Registro de Usuario Institucional",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Estado HTTP es 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Estructura de respuesta exitosa\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.success).to.be.true;",
              "    pm.expect(json.data).to.be.an('object');",
              "    pm.expect(json.data.institutionalEmail).to.include('@uniautonoma.edu.co');",
              "});",
              "",
              "pm.test(\"Reputación inicial asignada correctamente (rating 5.0, count 0)\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data.reputation.rating).to.eql(5);",
              "    pm.expect(json.data.reputation.returnedCount).to.eql(0);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    const json = pm.response.json();",
              "    pm.collectionVariables.set(\"registeredUserId\", json.data._id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Mariana López Narváez\",\n  \"institutionalEmail\": \"mariana.lopez@uniautonoma.edu.co\",\n  \"studentCode\": \"2024-1055\",\n  \"phone\": \"3123456789\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
